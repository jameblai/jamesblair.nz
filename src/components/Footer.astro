---
import { execSync } from "node:child_process";

import Link from "@/components/Link.astro";

const repositoryUrl = "https://github.com/jameblai/jamesblair.nz";

function getCommitSha() {
  const cloudflareSha = process.env.CF_PAGES_COMMIT_SHA;

  if (cloudflareSha) {
    return cloudflareSha.slice(0, 7);
  }

  try {
    return execSync("git rev-parse --short HEAD", {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  } catch {
    return "unknown";
  }
}

const commitSha = getCommitSha();
---

<footer
  class="text-fg-muted flex flex-col justify-between gap-4 font-mono text-sm md:flex-row md:items-start md:gap-8"
>
  <p>
    Built with <span class="text-fg">Astro</span>
    <span class="text-comment" aria-hidden="true">/</span>
    Commit <span class="text-fg">{commitSha}</span>
  </p>

  <Link href={repositoryUrl} class="text-sm">Source</Link>
</footer>
