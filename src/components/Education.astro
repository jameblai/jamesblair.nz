---
import Window from "@/components/Window.astro";
import { displayPeriod, education } from "@/lib/me";
---

<Window
  title="Education"
  heading="h2"
  id="education-title"
  class="tile-education"
>
  <div class="entry-list">
    {
      education.map((item) => {
        const period = displayPeriod(item);

        return (
          <fieldset>
            <legend>
              <h3>{item.degree}</h3>
            </legend>
            <p>{item.institution}</p>
            {period && <p class="meta">{period}</p>}
          </fieldset>
        );
      })
    }
  </div>
</Window>
