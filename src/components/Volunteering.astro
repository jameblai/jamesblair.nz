---
import Window from "@/components/Window.astro";
import { displayPeriod, volunteering } from "@/lib/me";
---

<Window
  title="Volunteering"
  heading="h2"
  id="volunteering-title"
  class="tile-volunteering"
>
  <div class="entry-list">
    {
      volunteering.map((item) => {
        const period = displayPeriod(item);

        return (
          <fieldset>
            <legend>
              <h3>{item.title}</h3>
            </legend>
            <p>{item.org}</p>
            {period && <p class="meta">{period}</p>}
            {item.description?.trim() && <p>{item.description}</p>}
          </fieldset>
        );
      })
    }
  </div>
</Window>
