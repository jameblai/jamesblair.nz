---
import HackathonCard from "@/components/HackathonCard.astro";
import Heading from "@/components/Heading.astro";
import { hackathons } from "@/lib/me";
---

<section class="flex flex-col gap-4">
  <Heading tag="h2">Hackathons</Heading>
  <div class="grid max-w-4xl gap-4">
    {hackathons.map((hackathon) => <HackathonCard hackathon={hackathon} />)}
  </div>
</section>
