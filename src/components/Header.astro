---
import Heading from "@/components/Heading.astro";
import Link from "@/components/Link.astro";

const headerLinks: { label: string; href: string }[] = [
  {
    label: "GitHub",
    href: "https://github.com/jameblai",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/jamesblair14",
  },
];
---

<header
  class="flex flex-col justify-between gap-4 md:flex-row md:items-start md:gap-8"
>
  <Heading tag="h1">
    <span>James Blair</span><span
      aria-hidden="true"
      class="bg-fg-muted vim-cursor inline-block align-baseline whitespace-pre"
      >{" "}</span
    >
  </Heading>

  <div class="flex gap-4">
    {headerLinks.map(({ label, href }) => <Link href={href}>{label}</Link>)}
  </div>
</header>
