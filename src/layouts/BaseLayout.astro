---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "James Blair",
  description = "First-year Computer Science student at The University of Auckland.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-full flex-col font-sans leading-relaxed">
    <slot />
  </body>
</html>
